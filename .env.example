# !STARTERCONF Duplicate this to .env.local

# DEVELOPMENT TOOLS
NEXT_PUBLIC_SHOW_LOGGER="false"

# CONTACT FORM — nodemailer SMTP (Gmail example)
# For Gmail: enable 2FA then generate an App Password at
# https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_TO="paulobitrim@gmail.com"

# GOOGLE SHEETS — contact list storage
# Setup: https://console.cloud.google.com → enable Sheets API → create Service Account
# Share your sheet with the service account email as Editor
GOOGLE_SHEETS_ID="your-sheet-id-from-url"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC123...\n-----END PRIVATE KEY-----\n"